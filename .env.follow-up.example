# Server-only credentials. Do not use NEXT_PUBLIC_ for these values.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated Supabase Auth user UUIDs authorized to publish and view sends.
WHATSAPP_STAFF_USER_IDS=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Use the Graph API version supported by the connected Meta app (e.g. vXX.0).
WHATSAPP_API_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_CRON_SECRET=
# Enable only after configuring the API, protected table, authenticated staff and scheduler.
WHATSAPP_AUTOMATIONS_ENABLED=false

# Local-only review laboratory. Ignored on Vercel; credentials are entered by admin
# in Follow Up > Testes WhatsApp and stored only under .avvi-local/whatsapp-lab.
AVVI_WHATSAPP_LOCAL_TEST=false
# For isolated automated tests only; omit for the normal local preview.
AVVI_WHATSAPP_LAB_DIRECTORY=
